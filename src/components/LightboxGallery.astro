---
import MaterialIcon from './MaterialIcon.astro'

interface GalleryItem {
  src: string
  alt: string
  thumb?: string
}

interface Props {
  items: GalleryItem[]
  columns?: 2 | 3 | 4
  class?: string
}

const {
  items = [],
  columns = 3,
  class: className
} = Astro.props as Props

const columnsClass = {
  2: 'grid-cols-2',
  3: 'grid-cols-2 md:grid-cols-3',
  4: 'grid-cols-2 md:grid-cols-4'
}[columns]
---

<section class={className}>
  <div class={['grid gap-3', columnsClass].join(' ')}>
    {items.map((item, index) => (
      <button
        type='button'
        class='group relative overflow-hidden rounded-xl'
        data-lightbox-open
        data-index={String(index)}
        data-src={item.src}
        data-alt={item.alt}
      >
        <img src={item.thumb || item.src} alt={item.alt} loading='lazy' decoding='async' class='h-full w-full object-cover transition-transform duration-300 group-hover:scale-105' />
      </button>
    ))}
  </div>
</section>

<dialog id='taia-lightbox' class='taia-lightbox'>
  <button class='taia-lightbox-close' type='button' aria-label='Close'>
    <MaterialIcon name='close' size={24} />
  </button>
  <button class='taia-lightbox-nav taia-lightbox-prev' type='button' aria-label='Previous image'>
    <MaterialIcon name='chevron_left' size={24} />
  </button>
  <figure class='taia-lightbox-stage'>
    <img class='taia-lightbox-image' alt='' />
  </figure>
  <button class='taia-lightbox-nav taia-lightbox-next' type='button' aria-label='Next image'>
    <MaterialIcon name='chevron_right' size={24} />
  </button>
  <p class='taia-lightbox-caption'></p>
  <p class='taia-lightbox-counter'></p>
</dialog>

<script is:inline>
  if (typeof window !== 'undefined' && !window.__taiaLightboxInit) {
    window.__taiaLightboxInit = true

    const overlay = document.getElementById('taia-lightbox')
    if (!overlay) {
      window.__taiaLightboxInit = false
    } else {
      const image = overlay.querySelector('.taia-lightbox-image')
      const caption = overlay.querySelector('.taia-lightbox-caption')
      const counter = overlay.querySelector('.taia-lightbox-counter')
      const closeButton = overlay.querySelector('.taia-lightbox-close')
      const prevButton = overlay.querySelector('.taia-lightbox-prev')
      const nextButton = overlay.querySelector('.taia-lightbox-next')
      const stage = overlay.querySelector('.taia-lightbox-stage')

    let gallery = []
    let currentIndex = 0
    let scale = 1
    let translateX = 0
    let translateY = 0
    let startX = 0
    let startY = 0
    let swipeActive = false
    let pointers = new Map()
    let pinchDistance = 0

    const clamp = (value, min, max) => Math.max(min, Math.min(max, value))

    const applyTransform = () => {
      if (!image) return
      image.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`
    }

    const resetTransform = () => {
      scale = 1
      translateX = 0
      translateY = 0
      applyTransform()
    }

    const getDistance = (a, b) => {
      const dx = a.x - b.x
      const dy = a.y - b.y
      return Math.hypot(dx, dy)
    }

    const updateView = () => {
      if (!image || !caption || !counter || !gallery[currentIndex]) return
      const item = gallery[currentIndex]
      image.src = item.src
      image.alt = item.alt || ''
      caption.textContent = item.alt || ''
      counter.textContent = `${currentIndex + 1}/${gallery.length}`
      resetTransform()
    }

    const goTo = (index) => {
      if (!gallery.length) return
      currentIndex = (index + gallery.length) % gallery.length
      updateView()
    }

    const openGallery = (items, index) => {
      gallery = items
      currentIndex = index
      updateView()
      overlay.showModal()
    }

      if (closeButton) closeButton.addEventListener('click', () => overlay.close())
      if (prevButton) prevButton.addEventListener('click', () => goTo(currentIndex - 1))
      if (nextButton) nextButton.addEventListener('click', () => goTo(currentIndex + 1))

    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) overlay.close()
    })

    overlay.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') goTo(currentIndex - 1)
      if (event.key === 'ArrowRight') goTo(currentIndex + 1)
    })

      if (image) {
        image.addEventListener('dblclick', (event) => {
          event.preventDefault()
          if (scale > 1.05) {
            resetTransform()
          } else {
            scale = 2
            applyTransform()
          }
        })
      }

      if (image) {
        image.addEventListener('wheel', (event) => {
          event.preventDefault()
          scale = clamp(scale + (event.deltaY < 0 ? 0.12 : -0.12), 1, 4)
          applyTransform()
        }, { passive: false })
      }

      if (stage) {
        stage.addEventListener('pointerdown', (event) => {
          pointers.set(event.pointerId, { x: event.clientX, y: event.clientY })
          if (pointers.size === 1) {
            swipeActive = true
            startX = event.clientX
            startY = event.clientY
          }
          if (pointers.size === 2) {
            const [a, b] = Array.from(pointers.values())
            pinchDistance = getDistance(a, b)
          }
          stage.setPointerCapture(event.pointerId)
        })
      }

      if (stage) {
        stage.addEventListener('pointermove', (event) => {
          if (!pointers.has(event.pointerId)) return
          pointers.set(event.pointerId, { x: event.clientX, y: event.clientY })

          if (pointers.size === 2) {
            const [a, b] = Array.from(pointers.values())
            const nextDistance = getDistance(a, b)
            if (pinchDistance > 0) {
              scale = clamp(scale * (nextDistance / pinchDistance), 1, 4)
              applyTransform()
            }
            pinchDistance = nextDistance
            return
          }

          if (pointers.size === 1 && scale > 1.01) {
            const dx = event.clientX - startX
            const dy = event.clientY - startY
            translateX += dx
            translateY += dy
            startX = event.clientX
            startY = event.clientY
            applyTransform()
          }
        })
      }

    const onPointerUp = (event) => {
      const last = pointers.get(event.pointerId)
      pointers.delete(event.pointerId)
      if (!last) return

      if (swipeActive && scale <= 1.05) {
        const dx = event.clientX - startX
        const dy = event.clientY - startY
        if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) goTo(currentIndex + 1)
          if (dx > 0) goTo(currentIndex - 1)
        }
      }
      if (pointers.size < 2) pinchDistance = 0
      if (pointers.size === 0) swipeActive = false
    }

      if (stage) {
        stage.addEventListener('pointerup', onPointerUp)
        stage.addEventListener('pointercancel', onPointerUp)
      }

      document.addEventListener('click', (event) => {
        const target = event.target
        if (!(target instanceof Element)) return
        const trigger = target.closest('[data-lightbox-open]')
        if (!trigger) return
        const section = trigger.closest('section')
        const triggers = section ? Array.from(section.querySelectorAll('[data-lightbox-open]')) : []
        const items = triggers.map((item) => ({
          src: item.getAttribute('data-src') || '',
          alt: item.getAttribute('data-alt') || ''
        })).filter((item) => item.src)
        const selectedIndex = Number(trigger.getAttribute('data-index') || '0')
        if (!items.length) return
        openGallery(items, clamp(selectedIndex, 0, items.length - 1))
      })
    }
  }
</script>

<style is:global>
  .taia-lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    border: 0;
    background: transparent;
    padding: 0;
  }

  .taia-lightbox::backdrop {
    background: rgba(4, 8, 14, 0.8);
  }

  .taia-lightbox-image {
    max-width: min(92vw, 1200px);
    max-height: calc(100dvh - 9rem);
    width: auto;
    height: auto;
    border-radius: 0.9rem;
    transform-origin: center center;
    touch-action: none;
    transition: transform 0.1s linear;
  }

  .taia-lightbox-caption {
    margin: 0.6rem 0 0;
    text-align: center;
    color: #f5f7ff;
  }

  .taia-lightbox-counter {
    margin: 0.35rem 0 0;
    text-align: center;
    color: rgba(245, 247, 255, 0.86);
    font-size: 0.9rem;
  }

  .taia-lightbox-stage {
    margin: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    inset: 0;
    padding: 2.4rem 4.2rem;
    box-sizing: border-box;
  }

  .taia-lightbox-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(12, 20, 34, 0.6);
    color: #fff;
    font-size: 1.3rem;
    cursor: pointer;
    z-index: 2;
  }

  .taia-lightbox-prev {
    left: 0.8rem;
  }

  .taia-lightbox-next {
    right: 0.8rem;
  }

  .taia-lightbox-close {
    position: fixed;
    top: 0.8rem;
    right: 0.8rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    background: rgba(12, 20, 34, 0.6);
    color: #fff;
    font-size: 1.8rem;
    cursor: pointer;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 9999px;
    z-index: 2;
  }

  .taia-lightbox-nav .taia-material-symbols,
  .taia-lightbox-close .taia-material-symbols {
    display: block;
    line-height: 1;
  }

  @media (max-width: 700px) {
    .taia-lightbox-stage {
      padding: 1rem 0.5rem 2.8rem;
    }

    .taia-lightbox-nav {
      top: auto;
      bottom: 1rem;
      transform: none;
    }

    .taia-lightbox-prev {
      left: calc(50% - 3rem);
    }

    .taia-lightbox-next {
      right: calc(50% - 3rem);
    }
  }
</style>
