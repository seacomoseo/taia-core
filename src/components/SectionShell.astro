---
/**
 * SectionShell - Consistent layout wrapper for page sections
 * Provides responsive padding, max-width, and semantic structure
 */
export interface Props {
  as?: 'section' | 'article' | 'div' | 'aside' | 'main' | 'header' | 'footer'
  id?: string
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full'
  padding?: 'none' | 'sm' | 'md' | 'lg'
  background?: 'default' | 'alt' | 'dark' | 'accent'
  class?: string
  'aria-labelledby'?: string
  'aria-label'?: string
}

const {
  as: Element = 'section',
  id,
  size = 'lg',
  padding = 'md',
  background = 'default',
  class: className,
  'aria-labelledby': ariaLabelledby,
  'aria-label': ariaLabel
} = Astro.props

const sizeClassMap = {
  sm: 'max-w-2xl',
  md: 'max-w-3xl',
  lg: 'max-w-5xl',
  xl: 'max-w-7xl',
  full: 'max-w-none'
} as const

const paddingClassMap = {
  none: 'py-0',
  sm: 'px-4 py-6 md:px-8',
  md: 'px-6 py-12 md:px-12',
  lg: 'px-8 py-20 md:px-16'
} as const

const backgroundClassMap = {
  default: 'bg-[var(--color-bg,#ffffff)]',
  alt: 'bg-[var(--color-bg-alt,#f5f5f5)]',
  dark: 'bg-[var(--color-bg-dark,#1a1a1a)] text-[var(--color-text-on-dark,#ffffff)]',
  accent: 'bg-[var(--color-accent,#3b82f6)] text-[var(--color-text-on-accent,#ffffff)]'
} as const

const classes = [
  'w-full',
  paddingClassMap[padding],
  backgroundClassMap[background],
  className
].filter(Boolean).join(' ')

const innerClasses = ['mx-auto w-full', sizeClassMap[size]].join(' ')
---

<Element
  id={id}
  class={classes}
  aria-labelledby={ariaLabelledby}
  aria-label={ariaLabel}
>
  <div class={innerClasses}>
    <slot />
  </div>
</Element>
