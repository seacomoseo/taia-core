---
/**
 * SectionShell - Consistent layout wrapper for page sections
 * Provides responsive padding, max-width, and semantic structure
 */
export interface Props {
  as?: 'section' | 'article' | 'div' | 'aside' | 'main' | 'header' | 'footer'
  id?: string
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full'
  padding?: 'none' | 'sm' | 'md' | 'lg'
  background?: 'default' | 'alt' | 'dark' | 'accent'
  class?: string
  'aria-labelledby'?: string
  'aria-label'?: string
}

const {
  as: Element = 'section',
  id,
  size = 'lg',
  padding = 'md',
  background = 'default',
  class: className,
  'aria-labelledby': ariaLabelledby,
  'aria-label': ariaLabel
} = Astro.props as Props

const sizeClassMap = {
  sm: 'max-w-2xl',
  md: 'max-w-3xl',
  lg: 'max-w-6xl',
  xl: 'max-w-[84rem]',
  full: 'max-w-none'
} as const

const paddingClassMap = {
  none: 'py-0',
  sm: 'px-4 py-8 md:px-8',
  md: 'px-6 py-12 md:px-10 lg:px-12',
  lg: 'px-6 py-16 md:px-10 lg:px-14 lg:py-20'
} as const

const backgroundClassMap = {
  default: 'bg-transparent',
  alt: 'bg-[linear-gradient(180deg,rgba(231,230,225,0.62),rgba(231,230,225,0.15))]',
  dark: 'bg-[linear-gradient(160deg,#0f2230,#132d3f)] text-[var(--color-text-on-dark,#ffffff)]',
  accent: 'bg-[linear-gradient(160deg,#b0432f,#8f3322)] text-[var(--color-text-on-accent,#ffffff)]'
} as const

const classes = [
  'relative w-full',
  paddingClassMap[padding],
  backgroundClassMap[background],
  className
].filter(Boolean).join(' ')

const innerClasses = ['mx-auto w-full', sizeClassMap[size]].join(' ')
---

<Element
  id={id}
  class={classes}
  aria-labelledby={ariaLabelledby}
  aria-label={ariaLabel}
>
  <div class={innerClasses}>
    <slot />
  </div>
</Element>
