---
interface FaqItem {
  question: string
  answer: string
}

interface Props {
  items: FaqItem[]
  withSchema?: boolean
  title?: string
  class?: string
}

const {
  items = [],
  withSchema = true,
  title,
  class: className
} = Astro.props as Props

const jsonLd = withSchema && items.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: items.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer
        }
      }))
    }
  : null
---

{items.length > 0 && (
  <section class={['space-y-3', className].filter(Boolean).join(' ')}>
    {title && <h2 class='taia-section-title text-3xl md:text-4xl'>{title}</h2>}
    {items.map((item, index) => (
      <details class='taia-surface group px-5 py-4' open={index === 0}>
        <summary class='cursor-pointer list-none pr-6 font-semibold'>
          <span>{item.question}</span>
          <span class='float-right text-[var(--color-text-muted)] transition-transform group-open:rotate-45'>+</span>
        </summary>
        <div class='mt-3 text-sm text-[var(--color-text-muted)]'>
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </section>
)}

{jsonLd && <script is:inline type='application/ld+json' set:html={JSON.stringify(jsonLd)} />}
