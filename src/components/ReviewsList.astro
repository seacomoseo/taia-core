---
interface ReviewItem {
  author: string
  rating: number
  body: string
  datePublished?: string
}

interface Props {
  itemName: string
  itemType?: 'Product' | 'Service' | 'Organization' | 'LocalBusiness'
  items: ReviewItem[]
  withSchema?: boolean
  class?: string
}

const {
  itemName,
  itemType = 'Product',
  items = [],
  withSchema = true,
  class: className
} = Astro.props as Props

const average = items.length > 0
  ? Number((items.reduce((total, item) => total + item.rating, 0) / items.length).toFixed(1))
  : 0

const jsonLd = withSchema && items.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': itemType,
      name: itemName,
      aggregateRating: {
        '@type': 'AggregateRating',
        ratingValue: average,
        reviewCount: items.length
      },
      review: items.map((item) => ({
        '@type': 'Review',
        author: {
          '@type': 'Person',
          name: item.author
        },
        reviewRating: {
          '@type': 'Rating',
          ratingValue: item.rating,
          bestRating: 5
        },
        reviewBody: item.body,
        datePublished: item.datePublished
      }))
    }
  : null
---

{items.length > 0 && (
  <section class={['space-y-4', className].filter(Boolean).join(' ')}>
    <header class='taia-surface px-5 py-4'>
      <h2 class='taia-section-title text-3xl'>Resenas</h2>
      <p class='mt-1 text-sm text-[var(--color-text-muted)]'>
        {average}/5 based on {items.length} reviews
      </p>
    </header>

    <div class='grid gap-4 md:grid-cols-2'>
      {items.map((item) => (
        <article class='taia-surface p-5'>
          <p class='text-sm font-semibold'>{item.author}</p>
          <p class='mt-1 text-amber-600' aria-label={`Rating ${item.rating} of 5`}>{'★'.repeat(Math.max(1, Math.min(5, Math.round(item.rating))))}</p>
          <p class='mt-3 text-sm text-[var(--color-text-muted)]'>{item.body}</p>
        </article>
      ))}
    </div>
  </section>
)}

{jsonLd && <script is:inline type='application/ld+json' set:html={JSON.stringify(jsonLd)} />}
