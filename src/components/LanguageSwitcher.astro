---
import SmartLink from './SmartLink.astro'
import { LanguageRouteService } from '../services/language-route-service'

interface Props {
  lang?: string
  compact?: boolean
  class?: string
}

const {
  lang = 'es',
  compact = false,
  class: className
} = Astro.props as Props

const routeService = new LanguageRouteService(process.cwd())
const defaultLang = routeService.getDefaultLanguage()
const languages = routeService.getLanguages()
const currentLang = languages.includes(lang) ? lang : defaultLang

const links = languages.map((locale) => {
  return {
    locale,
    href: routeService.resolveLocalizedPath(Astro.url.pathname, currentLang, locale),
    active: locale === currentLang
  }
})

const navLabel = currentLang === 'en' ? 'Language switcher' : 'Selector de idioma'
---

{languages.length > 1 && (
  <nav aria-label={navLabel} class={className}>
    {compact
      ? (
        <ul class='m-0 flex list-none items-center gap-2 p-0'>
          {links.map((item) => (
            <li>
              <SmartLink
                href={item.href}
                class={[
                  'text-xs font-semibold uppercase tracking-[0.08em] transition-colors',
                  item.active ? 'text-[var(--color-accent)]' : 'text-[var(--color-text-muted)] hover:text-[var(--color-accent)]'
                ].join(' ')}
                aria-current={item.active ? 'page' : undefined}
              >
                {item.locale}
              </SmartLink>
            </li>
          ))}
        </ul>
        )
      : (
        <>
          <ul class='hidden list-none items-center gap-1 md:flex'>
            {links.map((item) => (
              <li>
                <SmartLink
                  href={item.href}
                  class={[
                    'inline-flex rounded-full px-3 py-2 text-xs font-semibold uppercase tracking-[0.08em] transition-colors',
                    item.active
                      ? 'bg-[var(--color-accent)] text-white'
                      : 'border border-[var(--color-border)] bg-white/80 text-[var(--color-text-muted)] hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]'
                  ].join(' ')}
                  aria-current={item.active ? 'page' : undefined}
                >
                  {item.locale}
                </SmartLink>
              </li>
            ))}
          </ul>

          <details class='relative md:hidden'>
            <summary class='inline-flex cursor-pointer list-none rounded-full border border-[var(--color-border)] bg-white/85 px-3 py-2 text-xs font-semibold uppercase tracking-[0.08em] text-[var(--color-text)]'>
              {currentLang}
            </summary>
            <ul class='absolute right-0 z-20 mt-2 min-w-[7rem] list-none rounded-xl border border-[var(--color-border)] bg-white p-2 shadow-[var(--shadow-soft)]'>
              {links.map((item) => (
                <li>
                  <SmartLink
                    href={item.href}
                    class={[
                      'inline-flex w-full rounded-md px-2 py-1.5 text-xs font-semibold uppercase tracking-[0.08em] transition-colors',
                      item.active ? 'bg-[var(--color-bg-alt)] text-[var(--color-accent)]' : 'text-[var(--color-text-muted)] hover:bg-[var(--color-bg-alt)] hover:text-[var(--color-accent)]'
                    ].join(' ')}
                    aria-current={item.active ? 'page' : undefined}
                  >
                    {item.locale}
                  </SmartLink>
                </li>
              ))}
            </ul>
          </details>
        </>
        )}
  </nav>
)}
