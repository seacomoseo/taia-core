---
/**
 * SkipLink - Accessibility skip navigation link
 * Allows keyboard users to skip to main content
 */
interface Props {
  targetId?: string
  label?: string
}

const {
  targetId = 'main-content',
  label = 'Skip to main content'
} = Astro.props
---

<a href={`#${targetId}`} class="skip-link">
  {label}
</a>

<style>
  .skip-link {
    position: absolute;
    top: -5rem;
    left: 1rem;
    z-index: 9999;
    padding: 0.75rem 1rem;
    background-color: var(--color-accent, #b0432f);
    color: var(--color-text-on-accent, #ffffff);
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    box-shadow: var(--shadow-soft, 0 20px 40px -30px rgba(15, 34, 48, 0.55));
    transition: top 0.15s ease-in-out, background-color 0.15s ease-in-out;
  }

  .skip-link:focus {
    top: 1rem;
    outline: 2px solid var(--color-focus, #1d56b0);
    outline-offset: 2px;
  }

  .skip-link:hover {
    background-color: var(--color-accent-hover, #8f3322);
  }
</style>
