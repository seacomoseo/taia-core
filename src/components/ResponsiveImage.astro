---
interface Props {
  src: string
  alt: string
  width: number
  height: number
  sizes?: string
  srcset?: string
  avifSrcset?: string
  widths?: number[]
  loading?: 'lazy' | 'eager'
  decoding?: 'async' | 'sync' | 'auto'
  fetchpriority?: 'high' | 'low' | 'auto'
  schemaCaption?: string
  class?: string
}

const {
  src,
  alt,
  width,
  height,
  sizes = '100vw',
  srcset,
  avifSrcset,
  widths = [480, 768, 1024, 1440],
  loading = 'lazy',
  decoding = 'async',
  fetchpriority = 'auto',
  schemaCaption,
  class: className
} = Astro.props as Props

const isRemote = src.startsWith('http://') || src.startsWith('https://') || src.startsWith('//')
const isData = src.startsWith('data:')

const buildImageEndpoint = (format: 'avif' | 'webp' | 'png' | 'jpeg', targetWidth: number): string => {
  const href = encodeURIComponent(src)
  return `/_image?href=${href}&w=${targetWidth}&f=${format}`
}

const makeSrcset = (format: 'avif' | 'webp' | 'png' | 'jpeg'): string | undefined => {
  if (isRemote || isData) return undefined
  return widths.map((value) => `${buildImageEndpoint(format, value)} ${value}w`).join(', ')
}

const resolvedAvifSrcset = avifSrcset || makeSrcset('avif')
const resolvedFallbackSrcset = srcset || makeSrcset('webp')
const fallbackSrc = !isRemote && !isData ? buildImageEndpoint('webp', width) : src

const schemaJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: src,
  width,
  height,
  caption: schemaCaption || alt,
  description: alt
}
---

<picture>
  {resolvedAvifSrcset && <source type='image/avif' srcset={resolvedAvifSrcset} sizes={sizes} />}
  {resolvedFallbackSrcset && <source type='image/webp' srcset={resolvedFallbackSrcset} sizes={sizes} />}
  <img
    src={fallbackSrc}
    alt={alt}
    width={width}
    height={height}
    sizes={resolvedFallbackSrcset || resolvedAvifSrcset ? sizes : undefined}
    srcset={resolvedFallbackSrcset}
    loading={loading}
    decoding={decoding}
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>

<script is:inline type='application/ld+json' set:html={JSON.stringify(schemaJsonLd)} />

<style>
  picture,
  img {
    max-width: 100%;
    height: auto;
  }
</style>
