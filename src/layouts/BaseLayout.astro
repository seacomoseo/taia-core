---
import SeoHead from '../components/SeoHead.astro'
import SkipLink from '../components/SkipLink.astro'
import FocusOutlines from '../components/FocusOutlines.astro'
import '../styles/tailwind.css'
import { ConfigService } from '../services/config-service'
import type { JsonLd } from '../schemas/seo'

interface Props {
  title: string
  description: string
  canonical?: string | undefined
  image?: string | undefined
  imageAlt?: string | undefined
  type?: 'website' | 'article' | 'product' | undefined
  noindex?: boolean | undefined
  nofollow?: boolean | undefined
  publishedTime?: string | undefined
  modifiedTime?: string | undefined
  author?: string | undefined
  jsonLd?: JsonLd | JsonLd[] | undefined
  alternates?: Array<{ hreflang: string; href: string }> | undefined
  locale?: string | undefined
  siteName?: string | undefined
  twitterHandle?: string | undefined
  ga4Id?: string | undefined
  class?: string | undefined
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  nofollow = false,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
  alternates = [],
  locale = 'es',
  siteName = 'TAIA',
  twitterHandle,
  ga4Id,
  class: bodyClass
} = Astro.props

const htmlLang = locale.split('_')[0]
const configService = new ConfigService(process.cwd())
const taiaConfig = configService.getTaiaConfig()
const resolvedGa4Id = ga4Id || taiaConfig.ga4Id
const resolvedSiteName = siteName || taiaConfig.siteName || 'TAIA'
const faviconSource = taiaConfig.faviconSource || ''
const hasSvgFavicon = faviconSource.endsWith('.svg')
const baseBodyClass = 'min-h-screen text-[var(--color-text)] antialiased'
---

<!DOCTYPE html>
<html lang={htmlLang}>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='generator' content={Astro.generator} />

    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link href='https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Manrope:wght@400;500;600;700;800&display=swap' rel='stylesheet' />

    <link rel='icon' sizes='any' href='/favicon.ico' />
    {hasSvgFavicon && <link rel='icon' type='image/svg+xml' href='/favicon.svg' />}
    <link rel='icon apple-touch-icon' type='image/png' sizes='192x192' href='/favicon.png' />
    <link rel='manifest' href='/site.webmanifest' />

    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      type={type}
      locale={locale}
      siteName={resolvedSiteName}
      twitterHandle={twitterHandle}
      noindex={noindex}
      nofollow={nofollow}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      jsonLd={jsonLd}
      alternates={alternates}
    />

    <FocusOutlines />

    {resolvedGa4Id && (
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${resolvedGa4Id}`}></script>
    )}
    {resolvedGa4Id && (
      <script
        is:inline
        set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '${resolvedGa4Id}');`}
      />
    )}

    <slot name='head' />
  </head>
  <body class={[baseBodyClass, bodyClass].filter(Boolean).join(' ')}>
    <SkipLink />
    <slot />
    <slot name='footer-scripts' />
  </body>
</html>
