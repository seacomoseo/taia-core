---
/**
 * PageLayout - Single page wrapper
 * Includes header slot, main content, and footer slot
 */
import BaseLayout from './BaseLayout.astro'
import SectionShell from '../components/SectionShell.astro'
import type { JsonLd } from '../schemas/seo'

interface Props {
  // SEO
  title: string
  description: string
  canonical?: string | undefined
  image?: string | undefined
  imageAlt?: string | undefined
  type?: 'website' | 'article' | 'product' | undefined
  noindex?: boolean | undefined
  nofollow?: boolean | undefined
  publishedTime?: string | undefined
  modifiedTime?: string | undefined
  author?: string | undefined
  jsonLd?: JsonLd | JsonLd[] | undefined
  alternates?: Array<{ hreflang: string; href: string }> | undefined

  // Site config
  locale?: string | undefined
  siteName?: string | undefined
  twitterHandle?: string | undefined

  // Layout options
  contentSize?: 'sm' | 'md' | 'lg' | 'xl' | 'full' | undefined
  contentPadding?: 'none' | 'sm' | 'md' | 'lg' | undefined
  showBreadcrumbs?: boolean | undefined
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  nofollow = false,
  publishedTime,
  modifiedTime,
  author,
  jsonLd,
  alternates,
  locale = 'es',
  siteName,
  twitterHandle,
  contentSize = 'lg',
  contentPadding = 'md',
  showBreadcrumbs = false
} = Astro.props
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={imageAlt}
  type={type}
  noindex={noindex}
  nofollow={nofollow}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  author={author}
  jsonLd={jsonLd}
  alternates={alternates}
  locale={locale}
  siteName={siteName}
  twitterHandle={twitterHandle}
>
  <slot name="head" slot="head" />

  <slot name="header" />

  <main id="main-content" class="relative flex flex-1 flex-col pb-14 md:pb-20">
    {showBreadcrumbs && (
      <SectionShell as="div" size="lg" padding="sm" class="pt-6 md:pt-8">
        <slot name="breadcrumbs" />
      </SectionShell>
    )}

    <SectionShell
      as="div"
      size={contentSize}
      padding={contentPadding}
      class="flex-1"
    >
      <div class="taia-surface taia-fade-in overflow-hidden p-6 md:p-10">
        <slot />
      </div>
    </SectionShell>
  </main>

  <slot name="footer" />

  <slot name="footer-scripts" slot="footer-scripts" />
</BaseLayout>
