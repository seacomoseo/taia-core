---
/**
 * CollectionLayout - List/archive page layout
 * For blog posts, products, categories, etc.
 */
import BaseLayout from './BaseLayout.astro'
import SectionShell from '../components/SectionShell.astro'
import type { JsonLd } from '../schemas/seo'

interface Props {
  // SEO
  title: string
  description: string
  canonical?: string | undefined
  image?: string | undefined
  imageAlt?: string | undefined
  noindex?: boolean | undefined
  nofollow?: boolean | undefined
  jsonLd?: JsonLd | JsonLd[] | undefined
  alternates?: Array<{ hreflang: string; href: string }> | undefined

  // Site config
  locale?: string | undefined
  siteName?: string | undefined
  twitterHandle?: string | undefined

  // Collection options
  collectionTitle?: string | undefined
  totalItems?: number | undefined
  currentPage?: number | undefined
  totalPages?: number | undefined
  prevPage?: string | undefined
  nextPage?: string | undefined
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  jsonLd,
  alternates,
  locale = 'es',
  siteName,
  twitterHandle,
  collectionTitle,
  totalItems,
  currentPage = 1,
  totalPages = 1,
  prevPage,
  nextPage
} = Astro.props

const showPagination = totalPages > 1
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={imageAlt}
  type="website"
  noindex={noindex}
  nofollow={nofollow}
  jsonLd={jsonLd}
  alternates={alternates}
  locale={locale}
  siteName={siteName}
  twitterHandle={twitterHandle}
>
  <slot name="head" slot="head" />

  <slot name="header" />

  <main id="main-content" class="flex-1">
    <SectionShell size="lg" padding="md">
      <!-- Collection Header -->
      <header class="mb-8 text-center">
        {collectionTitle && (
          <h1 class="mb-2 text-4xl font-bold leading-tight md:text-5xl">{collectionTitle}</h1>
        )}
        {totalItems !== undefined && (
          <p class="text-sm text-[var(--color-text-muted)]">
            {totalItems} {totalItems === 1 ? 'item' : 'items'}
          </p>
        )}

        <slot name="filters" />
      </header>

      <!-- Collection Grid -->
      <div class="mb-12 grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-6 md:grid-cols-[repeat(auto-fill,minmax(320px,1fr))]">
        <slot />
      </div>

      <!-- Pagination -->
      {showPagination && (
        <nav class="flex items-center justify-center gap-6 border-t border-[var(--color-border)] pt-8" aria-label="Pagination">
          {prevPage
            ? (
              <a href={prevPage} class="rounded-md px-4 py-2 font-medium transition-colors hover:bg-[var(--color-bg-alt)]">
               ← Previous
              </a>
            )
            : (
              <span class="cursor-not-allowed rounded-md px-4 py-2 font-medium opacity-50">
               ← Previous
              </span>
            )}

          <span class="text-sm text-[var(--color-text-muted)]">
            Page {currentPage} of {totalPages}
          </span>

          {nextPage
            ? (
              <a href={nextPage} class="rounded-md px-4 py-2 font-medium transition-colors hover:bg-[var(--color-bg-alt)]">
               Next →
              </a>
            )
            : (
              <span class="cursor-not-allowed rounded-md px-4 py-2 font-medium opacity-50">
               Next →
              </span>
            )}
        </nav>
      )}
    </SectionShell>
  </main>

  <slot name="footer" />

  <slot name="footer-scripts" slot="footer-scripts" />
</BaseLayout>
