---
/**
 * CollectionLayout - List/archive page layout
 * For blog posts, products, categories, etc.
 */
import BaseLayout from './BaseLayout.astro'
import SectionShell from '../components/SectionShell.astro'
import type { JsonLd } from '../schemas/seo'

interface Props {
  // SEO
  title: string
  description: string
  canonical?: string | undefined
  image?: string | undefined
  imageAlt?: string | undefined
  noindex?: boolean | undefined
  nofollow?: boolean | undefined
  jsonLd?: JsonLd | JsonLd[] | undefined
  alternates?: Array<{ hreflang: string; href: string }> | undefined

  // Site config
  locale?: string | undefined
  siteName?: string | undefined
  twitterHandle?: string | undefined

  // Collection options
  collectionTitle?: string | undefined
  totalItems?: number | undefined
  currentPage?: number | undefined
  totalPages?: number | undefined
  prevPage?: string | undefined
  nextPage?: string | undefined
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  noindex = false,
  nofollow = false,
  jsonLd,
  alternates,
  locale = 'es',
  siteName,
  twitterHandle,
  collectionTitle,
  totalItems,
  currentPage = 1,
  totalPages = 1,
  prevPage,
  nextPage
} = Astro.props

const showPagination = totalPages > 1
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  imageAlt={imageAlt}
  type="website"
  noindex={noindex}
  nofollow={nofollow}
  jsonLd={jsonLd}
  alternates={alternates}
  locale={locale}
  siteName={siteName}
  twitterHandle={twitterHandle}
>
  <slot name="head" slot="head" />

  <slot name="header" />

  <main id="main-content" class="flex-1 pb-16 md:pb-20">
    <SectionShell size="lg" padding="md">
      <header class="taia-surface taia-fade-in mb-8 px-6 py-8 text-center md:px-10 md:py-10">
        <span class="taia-kicker mx-auto mb-4">Archivo</span>
        {collectionTitle && (
          <h1 class="taia-section-title mb-3 text-4xl text-balance md:text-5xl">{collectionTitle}</h1>
        )}
        {totalItems !== undefined && (
          <p class="mx-auto max-w-xl text-sm text-[var(--color-text-muted)] md:text-base">
            {totalItems} {totalItems === 1 ? 'item' : 'items'}
          </p>
        )}

        <div class="mt-5">
          <slot name="filters" />
        </div>
      </header>

      <div class="mb-12 grid grid-cols-[repeat(auto-fill,minmax(270px,1fr))] gap-6 md:grid-cols-[repeat(auto-fill,minmax(320px,1fr))]">
        <slot />
      </div>

      {showPagination && (
        <nav class="taia-surface flex items-center justify-center gap-3 px-5 py-4 md:gap-5 md:px-8" aria-label="Pagination">
          {prevPage
            ? (
              <a href={prevPage} class="inline-flex items-center rounded-full border border-[var(--color-border)] bg-white/80 px-4 py-2 text-sm font-semibold transition-colors hover:border-[var(--color-border-strong)] hover:bg-[var(--color-bg-alt)] md:text-base">
                ← Previous
              </a>
            )
            : (
              <span class="cursor-not-allowed rounded-full border border-[var(--color-border)] px-4 py-2 text-sm font-semibold opacity-45 md:text-base">
                ← Previous
              </span>
            )}

          <span class="text-sm font-medium text-[var(--color-text-muted)] md:text-base">
            Page {currentPage} of {totalPages}
          </span>

          {nextPage
            ? (
              <a href={nextPage} class="inline-flex items-center rounded-full border border-[var(--color-border)] bg-white/80 px-4 py-2 text-sm font-semibold transition-colors hover:border-[var(--color-border-strong)] hover:bg-[var(--color-bg-alt)] md:text-base">
                Next →
              </a>
            )
            : (
              <span class="cursor-not-allowed rounded-full border border-[var(--color-border)] px-4 py-2 text-sm font-semibold opacity-45 md:text-base">
                Next →
              </span>
            )}
        </nav>
      )}
    </SectionShell>
  </main>

  <slot name="footer" />

  <slot name="footer-scripts" slot="footer-scripts" />
</BaseLayout>
