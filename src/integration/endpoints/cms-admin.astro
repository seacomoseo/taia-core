---
import { ConfigService } from '../../services/config-service'

const title = 'CMS'
const configService = new ConfigService(process.cwd())
const configVersion = configService.getCmsConfigFingerprint()
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>{title}</title>

  <!-- Sveltia CMS -->
  <link href={`/admin/config.yml?v=${configVersion}`} type="application/yaml" rel="cms-config-url" />
  <script src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js" type="module"></script>
  <style is:global>
    /* Variables CSS Sveltia Override */
    :root {
      --sveltia-cms-brand-color: #f97316;
    }
    /* HINT */
    .group > .inner > .wrapper > .content {
      padding-bottom: 128px;
    }
    .footer {
      justify-content: flex-start !important;
      position: relative;
    }
    .footer:hover {
      z-index: 10;
    }
    .footer:has(.hint)::before {
      content: 'info';
      font-family: 'Material Symbols Outlined';
      font-weight: normal;
      font-style: normal;
      /* font-size: 24px; */
      line-height: 1;
      letter-spacing: normal;
      text-transform: none;
      display: inline-block;
      white-space: nowrap;
      word-wrap: normal;
      direction: ltr;
      font-feature-settings: 'liga';
      -webkit-font-feature-settings: 'liga';
      -webkit-font-smoothing: antialiased;
      color: var(--sui-button-primary-background-color, var(--sui-primary-accent-color));
      margin: 0.2em 0 -0.3em 0.2em;
    }
    .footer:has(.hint):hover::before {
      z-index: 20;
    }
    .hint {
      position: absolute;
      padding: 10px 18px;
      border-radius: var(--sui-control-medium-border-radius);
      background-color: var(--sui-textbox-background-color);
      opacity: 1;
    }
    .hint:not(.footer:hover *) {
      display: none;
    }
    /* MARKDOWN */
    @media (max-width: 767px) {
      [data-field-type="markdown"] .footer {
        position: relative;
        left: calc(var(--field-editor-padding) * -1);
        width: 100dvw;
        margin-top: 16px;
      }
    }
    /* OBJECT */
    [data-field-type="object"] {
      position: relative;
    }
    [data-field-type="object"] > header:not(:has(.required)) {
      padding-left: var(--sui-checkbox-height);
    }
    [data-field-type="object"] > .field-wrapper {
      display: grid;
    }
    [data-field-type="object"] > .field-wrapper > .checkbox {
      position: absolute;
      top: calc(var(--field-editor-padding) + (var(--sui-button-small-height) - 24px) / 2);
      margin: 0;
    }
    [data-field-type="object"] > .field-wrapper > .checkbox label {
      display: none;
    }
    [data-field-type="object"] > .field-wrapper:has(> .checkbox [aria-checked="false"]) {
      margin-top: -8px;
    }
    /* LIST */
    [data-field-type="list"] {
      --item-top: calc(var(--field-editor-padding) + (var(--sui-button-small-height) - 24px) / 2);
      --button-top: calc(var(--item-top) + (24px - var(--sui-checkbox-height)) / 2);
      --badge-top: calc(var(--item-top) + 1px);
      position: relative;
    }
    [data-field-type="list"] > header {
      padding-left: calc(var(--sui-checkbox-height) + 6px + 22px);
      
    }
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child {
      min-height: 32px;
    }
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child > .button:first-child {
      position: absolute;
      top: var(--button-top);
      margin: 0;
      width: var(--sui-checkbox-height);
      height: var(--sui-checkbox-height);
      border-radius: var(--sui-button-small-border-radius);
      border-width: var(--sui-button-tertiary-border-width, 1px);
      border-style: var(--sui-button-tertiary-border-style, solid);
      border-color: var(--sui-button-tertiary-border-color, var(--sui-button-border-color));
      background-color: var(--sui-button-tertiary-background-color, var(--sui-button-background-color));
      transition: none;
    }
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child > .button:first-child > .icon {
      font-size: calc(var(--sui-checkbox-height) - 2px);
    }
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child > .summary {
      position: absolute;
      top: var(--badge-top);
      margin-left: calc(var(--sui-checkbox-height) + 6px);
      font-size: 12px;
      padding-block: calc((22px - 2ch) / 2);
      padding-inline: calc((22px - var(--wch, 1ch) * 0.925) / 2);
      width: 22px;
      height: 22px;
      word-spacing: 20ch;
      white-space: nowrap;
      font-variant-numeric: tabular-nums;
      overflow: hidden;
      line-height: 2.2ch;
      /* border-radius: var(--sui-button-small-border-radius); */
      border-radius: 50%;
      background-color: var(--sui-primary-accent-color-translucent);
    }
    /* Unexpanded */
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child:has(> .button[aria-expanded="false"]:first-child) {
      margin-bottom: -38px;
    }
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child:has(> .button[aria-expanded="false"]:first-child) ~ .toolbar.bottom:last-child {
      display: none;
    }
    /* Many items */
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child:has(~ .item-list > *:nth-child(10)) {
      --wch: 2ch;
    }
    /* 1 item */
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child:not(:has(> .button.tertiary)) {
      margin-bottom: -38px;
    }
    /* 0 items */
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child:has(> .button[disabled]:first-child) > .button:first-child {
      opacity: 0;
    }
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child:has(> .button[disabled]:first-child) ~ .toolbar.top.add {
      margin-bottom: -8px !important;
    }
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child:has(> .button[disabled]:first-child) ~ .toolbar.top.add > .button {
      position: absolute;
      top: var(--button-top);
      margin: 0;
      max-width: var(--sui-checkbox-height);
      max-height: var(--sui-checkbox-height);
    }
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child:has(> .button[disabled]:first-child) ~ .toolbar.top.add > .button > .icon {
      font-size: var(--sui-checkbox-height);
    }
    [data-field-type="list"] > .field-wrapper > .group > .inner > .toolbar.top:first-child:has(> .button[disabled]:first-child) ~ .toolbar.top.add > .button > .label {
      display: none;
    }
  </style>
</head>
<body>
</body>
</html>
