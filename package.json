{
  "name": "taia-core",
  "version": "1.0.0",
  "description": "TAIA Core - Reusable primitives, layouts and agent rails for high-performance Astro sites",
  "type": "module",
  "exports": {
    "./components/*": "./src/components/*",
    "./layouts/*": "./src/layouts/*",
    "./integration": "./src/integration/taia-core.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/*": "./src/schemas/*",
    "./utils/*": "./src/utils/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . --ext .ts,.astro,.js",
    "lint:fix": "eslint . --ext .ts,.astro,.js --fix",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "taia:validate": "tsx src/scripts/validate.ts",
    "taia:links": "tsx src/scripts/link-checker.ts",
    "taia:lighthouse": "tsx src/scripts/lighthouse.ts"
  },
  "dependencies": {
    "astro": "^5.1.0",
    "js-yaml": "^4.1.1",
    "mime-types": "^3.0.2",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5",
    "yaml": "^2.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
